{
  "info": {
    "name": "Prominno API Collection",
    "description": "API collection for Admin and Seller functionalities",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin APIs",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"12345678\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "login"
              ]
            }
          }
        },
        {
          "name": "Create Seller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"1234567890\",\n  \"country\": \"USA\",\n  \"state\": \"California\",\n  \"password\": \"password123\",\n  \"skills\": [\"PHP\", \"Laravel\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/sellers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "sellers"
              ]
            }
          }
        },
        {
          "name": "List Sellers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/sellers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "sellers"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Seller APIs",
      "item": [
        {
          "name": "Seller Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller@gmail.com\",\n  \"password\": \"12345678\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/seller/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "seller",
                "login"
              ]
            }
          }
        },
        {
          "name": "Add Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{seller_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_name\": \"Mouse\",\n  \"product_description\": \"Wireless Mouse\",\n  \"brands\": [\n    {\n      \"name\": \"Dell\",\n      \"description\": \"Dell Wireless Mouse\",\n      \"price\": 25.99\n    },\n    {\n      \"name\": \"HP\",\n      \"description\": \"HP Wireless Mouse\",\n      \"price\": 29.99\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/seller/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "seller",
                "products"
              ]
            }
          }
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{seller_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/seller/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "seller",
                "products"
              ]
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{seller_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/seller/products/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "seller",
                "products",
                "1"
              ]
            }
          }
        },
        {
          "name": "Download Product PDF",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{seller_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/seller/products/1/pdf",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "seller",
                "products",
                "1",
                "pdf"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "seller_token",
      "value": ""
    }
  ]
}
